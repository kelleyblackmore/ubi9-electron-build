# syntax=docker/dockerfile:1
#
# Build Linux distributables (tar.gz + rpm) for an Electron app on Red Hat UBI 9.
# Reliable and fully native — no Wine, no emulation.
#
#   docker build -f Dockerfile.linux --target export -o type=local,dest=./out-linux .
#
# drops the artifacts on the host under ./out-linux/.

FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder

# dnf + electron-builder's rpm target need root; the base image runs as uid 1001.
USER 0

# rpmbuild is required for the rpm target; tar/gzip are already present.
RUN dnf install -y --nodocs rpm-build && dnf clean all

WORKDIR /build

COPY example-app/package.json ./
RUN npm install

COPY example-app/ ./

RUN mkdir -p /artifacts \
 && node make-icon.js \
 && npx --no-install electron-builder --linux tar.gz rpm --publish never \
 && cp dist/*.tar.gz dist/*.rpm /artifacts/ \
 && ls -lh /artifacts

# ---- export: scratch image holding only the artifacts, for --output ----
FROM scratch AS export
COPY --from=builder /artifacts/ /
