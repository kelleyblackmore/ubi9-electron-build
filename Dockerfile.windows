# syntax=docker/dockerfile:1
#
# Build a Windows NSIS installer for an Electron app on Red Hat UBI 9 via Wine.
#
# EXPERIMENTAL. electron-builder builds Windows targets on Linux by shelling out
# to Windows executables under Wine. Wine on RHEL/UBI 9 is not in the default
# repos — it comes from EPEL and pulls a large (and historically fussy) 32-bit
# dependency set. If this image proves unreliable in your environment, the
# proven fallback is Debian + Wine (see Dockerfile.windows.debian / README).
#
#   docker build -f Dockerfile.windows --target export -o type=local,dest=./out-win .

FROM registry.access.redhat.com/ubi9/nodejs-22:latest AS builder

USER 0

# EPEL (for wine) + CRB (for some wine deps). --skip-broken keeps the layer from
# dying if an optional 32-bit dep is unavailable; the wineboot below is the real
# smoke test of whether Wine is usable.
RUN dnf install -y --nodocs https://dl.fedoraproject.org/pub/epel/epel-release-latest-9.noarch.rpm \
 && dnf install -y --nodocs --enablerepo=crb --skip-broken wine \
 && dnf clean all

ENV WINEDEBUG=-all \
    WINEDLLOVERRIDES="mscoree,mshtml=" \
    WINEPREFIX=/opt/wineprefix

WORKDIR /build

COPY example-app/package.json ./
RUN npm install

COPY example-app/ ./

RUN wineboot --init > /dev/null 2>&1 || true

RUN mkdir -p /artifacts \
 && node make-icon.js \
 && npx --no-install electron-builder --win nsis --publish never \
 && cp dist/*.exe /artifacts/ \
 && ls -lh /artifacts

FROM scratch AS export
COPY --from=builder /artifacts/ /
