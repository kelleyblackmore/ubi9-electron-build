# syntax=docker/dockerfile:1
#
# Build a Windows NSIS installer for an Electron app in a container.
#
# This deliberately does NOT use UBI 9. Windows builds need Wine, and Wine on
# RHEL/UBI 9 is out-of-repo (EPEL) and historically fussy with its 32-bit deps.
# So for the Windows target we use `electronuserland/builder:wine` — the
# maintained Debian + Wine + Node image that electron-builder itself targets for
# Linux-hosted Windows builds. UBI 9 stays the base for the Linux + CI images,
# where it's native and the right call for RHEL-family environments.
#
#   docker build -f Dockerfile.windows --target export -o type=local,dest=./out-win .

FROM electronuserland/builder:wine AS builder

WORKDIR /build

COPY example-app/package.json ./
RUN npm install

COPY example-app/ ./

RUN mkdir -p /artifacts \
 && node make-icon.js \
 && npx --no-install electron-builder --win nsis --publish never \
 && cp dist/*.exe /artifacts/ \
 && ls -lh /artifacts

# ---- export: scratch image holding only the artifacts, for --output ----
FROM scratch AS export
COPY --from=builder /artifacts/ /
